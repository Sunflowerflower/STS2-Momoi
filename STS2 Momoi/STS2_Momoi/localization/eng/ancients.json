{
  "NEOW.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.0-0r.char": "OMAIGOTO, IT'S...",
  "NEOW.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.0-0r.next": "Continue",
  "NEOW.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.0-1r.ancient": "[sine]...Don't say... that...[/sine]",
  "NEOW.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.0-1r.next": "Continue",
  "NEOW.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.0-2r.char": "Which one?",
  "NEOW.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.0-visit": "0",
  "NEOW.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.1-0r.char": "That was fun! One more run!",
  "NEOW.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.1-0r.next": "Continue",
  "NEOW.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.1-1r.ancient": "[sine]...As long as... you're happy...[/sine]",
  "NEOW.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.1-visit": "1",
  "NEOW.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.2-0r.char": "What a garbage elite! I refuse! Again!",
  "NEOW.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.2-0r.next": "Fuming",
  "NEOW.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.2-1r.ancient": "[sine]...Skill issue... practice more...[/sine]",
  "NEOW.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.2-visit": "2",
  "NEOW.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.3-0r.char": "Last run's start was awful! Blue slippers, give me a good relic!",
  "NEOW.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.3-0r.next": "Continue",
  "NEOW.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.3-1r.ancient": "[sine]...Not satisfied... then roll...[/sine]",
  "NEOW.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.3-1r.next": "Continue",
  "NEOW.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.3-2r.ancient": "[sine]...Now look... at this one...[/sine]",
  "NEOW.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.3-visit": "3",
  "DARV.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.0-0r.ancient": "You're climbing the Spire too? Want me to set you up with some high-tier gear?",
  "DARV.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.0-0r.next": "Continue",
  "DARV.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.0-1r.char": "Whoa, a veteran!",
  "DARV.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.0-1r.next": "Continue",
  "DARV.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.0-2r.ancient": "?",
  "DARV.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.0-visit": "0",
  "DARV.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.1-0r.char": "I respect you, veteran! Give me a [gold]Dusty Tome[/gold]! Let me reclaim my true power!",
  "DARV.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.1-0r.next": "Continue",
  "DARV.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.1-1r.ancient": "Let me see if I have one this time...",
  "DARV.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.1-visit": "1",
  "DARV.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.2-0r.char": "Veteran, give me a [gold]Pyramid[/gold]! I want to play that thing this run!",
  "DARV.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.2-0r.next": "Continue",
  "DARV.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.2-1r.ancient": "Hahaha, haven't seen anyone play that in ages! That'll annoy someone! Let me look...",
  "DARV.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.2-visit": "2",
  "DARV.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.3-0r.char": "Trash man, stop giving me the [gold]green hat[/gold] and [gold]dog collar[/gold]... You screwed me last time!",
  "DARV.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.3-0r.next": "Continue",
  "DARV.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.3-1r.ancient": "Oops, my bad! Let's see what we have this time!",
  "DARV.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.3-visit": "3",
  "NONUPEIPE.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.0-0r.ancient": "Oh! A cute girl with a halo! It's been so long since I saw such a young visitor!",
  "NONUPEIPE.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.0-0r.next": "Continue",
  "NONUPEIPE.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.0-1r.char": "Is this the most beautiful woman in the Spire...",
  "NONUPEIPE.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.0-1r.next": "Continue",
  "NONUPEIPE.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.0-2r.ancient": "Ohoho, what a sweet tongue! Take my blessing and continue your journey!",
  "NONUPEIPE.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.0-visit": "0",
  "NONUPEIPE.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.1-0r.char": "I crawled all the way here... If only I had an [gold]Apotheosis[/gold].",
  "NONUPEIPE.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.1-0r.next": "Continue",
  "NONUPEIPE.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.1-1r.ancient": "Then let's see what blessing I prepared for you this time!",
  "NONUPEIPE.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.1-visit": "1",
  "NONUPEIPE.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.2-0r.char": "Good to see you again! It's reassuring, unlike a certain neighbor...",
  "NONUPEIPE.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.2-0r.next": "Continue",
  "NONUPEIPE.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.2-1r.ancient": "Do you like my generosity? Otherworldly walkthrough-reader, this blessing won't disappoint either!",
  "NONUPEIPE.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.2-visit": "2",
  "NONUPEIPE.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.3-0r.ancient": "It's cute little Momoi! You're back. What class this time? Warrior, thief, or priest?",
  "NONUPEIPE.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.3-0r.next": "Continue",
  "NONUPEIPE.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.3-1r.char": "No, I'm going to become the King of Games!",
  "NONUPEIPE.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.3-1r.next": "Continue",
  "NONUPEIPE.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.3-2r.ancient": "Defeat [red]the Architect[/red] and you can become the King of Games.",
  "NONUPEIPE.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.3-2r.next": "Continue",
  "NONUPEIPE.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.3-3r.char": "I have to fight [red]the Architect[/red]? For real...?",
  "NONUPEIPE.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.3-visit": "3",
  "OROBAS.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.0-0r.ancient": "A halo?! And a gun!!",
  "OROBAS.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.0-0r.next": "Continue",
  "OROBAS.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.0-1r.char": "Where I'm from, these are standard issue!",
  "OROBAS.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.0-1r.next": "Continue",
  "OROBAS.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.0-2r.ancient": "But! Gun! Dangerous! Take this! This is safe!",
  "OROBAS.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.0-visit": "0",
  "OROBAS.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.1-0r.ancient": "Angel and demon fighting?! Fighting bad! Peace good!!",
  "OROBAS.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.1-0r.next": "Continue",
  "OROBAS.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.1-1r.ancient": "Peace is fake? Lies bad!! Betrayal also bad!!!",
  "OROBAS.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.1-visit": "1",
  "OROBAS.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.2-0r.ancient": "[color=#000000]She[/color] coveted a whole city?! How?! Tell me more!! And then?!!",
  "OROBAS.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.2-visit": "2",
  "OROBAS.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.3-0r.ancient": "Break the halo? That's bad! Go save [blue]her[/blue]! Everyone went? That's right!! That's good!!!",
  "OROBAS.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.3-visit": "3",
  "PAEL.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.0-0r.ancient": "A new face...",
  "PAEL.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.0-0r.next": "Continue",
  "PAEL.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.0-1r.ancient": "Take a part of me and continue on your way.",
  "PAEL.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.0-visit": "0",
  "PAEL.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.1-0r.ancient": "Knowing this journey may [red]kill[/red] you, why still go forward?",
  "PAEL.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.1-0r.next": "Continue",
  "PAEL.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.1-1r.char": "Because [red]death[/red] is inevitable, I have to [green]live[/green] meaningfully right now!",
  "PAEL.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.1-visit": "1",
  "PAEL.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.2-0r.ancient": "Relax for a while, Momoi...",
  "PAEL.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.2-0r.next": "Continue",
  "PAEL.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.2-1r.char": "Might as well. Sharpening the axe doesn't delay the woodcutting.",
  "PAEL.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.2-visit": "2",
  "PAEL.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.3-0r.char": "Any [gold]clones[/gold] this time? I grabbed cards suited for [gold]cloning[/gold]!",
  "PAEL.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.3-0r.next": "Continue",
  "PAEL.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.3-1r.ancient": "I don't know... Let's see if this piece works?",
  "PAEL.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.3-1r.next": "Continue",
  "PAEL.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.3-2r.char": "Kimi!!!",
  "PAEL.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.3-visit": "3",
  "TANX.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.0-0r.ancient": "[b]Such a young girl, but I can feel your potential! Get stronger quickly!![/b]",
  "TANX.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.0-0r.next": "Continue",
  "TANX.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.0-1r.char": "I'll become the King of Games!",
  "TANX.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.0-visit": "0",
  "TANX.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.1-0r.ancient": "[b]Still using a [pink]G3[/pink]? That gun has no power! Look at the [gold]M14[/gold] I prepared! Fully modded![/b]",
  "TANX.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.1-0r.next": "Continue",
  "TANX.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.1-1r.char": "This gun has power!",
  "TANX.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.1-visit": "1",
  "TANX.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.2-0r.ancient": "[b]Momoi, have you become the King of Games? Come fight me![/b]",
  "TANX.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.2-visit": "2",
  "TANX.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.3-0r.ancient": "[b]Wang Xiaotao, fight me![/b]",
  "TANX.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.3-0r.next": "Continue",
  "TANX.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.3-1r.char": "[i][font_size=22]Momoi fought Tanx.[/font_size][/i]",
  "TANX.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.3-1r.next": "Continue",
  "TANX.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.3-2r.ancient": "[b]As expected of the King of Games! Take this![/b]",
  "TANX.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.3-visit": "3",
  "TEZCATARA.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.0-0r.ancient": "Another guest? Welcome to the Spire, cutie~ Want something to eat?",
  "TEZCATARA.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.0-visit": "0",
  "TEZCATARA.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.1-0r.ancient": "You're saying you have a [green]sister[/green] just like you? Will she come? Will you [jitter][b]fight[/b][/jitter] together?",
  "TEZCATARA.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.1-0r.next": "Continue",
  "TEZCATARA.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.1-1r.char": "Depends. At least the author has no energy for that in the short term QwQ.",
  "TEZCATARA.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.1-visit": "1",
  "TEZCATARA.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.2-0r.ancient": "You mean the [blue]hero[/blue] sacrificed themself to save the world, and the [pink]key[/pink] sacrificed themself to save the [blue]princess[/blue]?",
  "TEZCATARA.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.2-0r.next": "Continue",
  "TEZCATARA.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.2-1r.ancient": "...What a noble sacrifice...",
  "TEZCATARA.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.2-1r.next": "Continue",
  "TEZCATARA.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.2-2r.char": "What a pair of star-crossed lovers...",
  "TEZCATARA.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.2-visit": "2",
  "TEZCATARA.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.3-0r.ancient": "You mean they worked together to awaken the [pink]key[/pink]?",
  "TEZCATARA.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.3-0r.next": "Continue",
  "TEZCATARA.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.3-1r.ancient": "...What a touching reunion...",
  "TEZCATARA.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.3-visit": "3",
  "VAKUU.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.0-0r.ancient": "An angel with a halo? I hate angels...",
  "VAKUU.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.0-0r.next": "Continue",
  "VAKUU.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.0-1r.char": "I hate demons too...",
  "VAKUU.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.0-visit": "0",
  "VAKUU.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.1-0r.char": "Only these few [red]curses[/red]? My [gold]Concept[/gold] deck stuffs more than this.",
  "VAKUU.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.1-0r.next": "Continue",
  "VAKUU.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.1-1r.ancient": "Child, you're invincible...",
  "VAKUU.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.1-visit": "1",
  "VAKUU.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.2-0r.ancient": "I never expected someone who ignores contracts. Is the halo protecting you?",
  "VAKUU.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.2-0r.next": "Continue",
  "VAKUU.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.2-1r.char": "It's my [aqua]companions[/aqua] walking beside me, and [aqua]courage[/aqua]!",
  "VAKUU.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.2-1r.next": "Continue",
  "VAKUU.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.2-2r.ancient": "...What a boring story.",
  "VAKUU.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.2-visit": "2",
  "VAKUU.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.3-0r.ancient": "I heard your fanwork district is in turmoil!",
  "VAKUU.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.3-0r.next": "Continue",
  "VAKUU.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.3-1r.char": "[i][font_size=22]Vakuu laughs.[/font_size][/i]",
  "VAKUU.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.3-1r.next": "Continue",
  "VAKUU.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.3-2r.char": "...",
  "VAKUU.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.3-2r.next": "Continue",
  "VAKUU.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.3-3r.ancient": "[red]Traffic[/red] or [green]quality[/green]. Choose one.",
  "VAKUU.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.3-3r.next": "Continue",
  "VAKUU.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.3-4r.char": "I want both!",
  "VAKUU.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.3-visit": "3",
  "THE_ARCHITECT.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.0-0r.char": "Finally here! The view from the top is pretty nice.",
  "THE_ARCHITECT.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.0-0r.next": "Continue",
  "THE_ARCHITECT.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.0-1r.ancient": "Looked enough? Then go down.",
  "THE_ARCHITECT.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.0-1r.next": "Continue",
  "THE_ARCHITECT.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.0-2r.char": "You'd better not show a health bar!",
  "THE_ARCHITECT.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.1-0r.ancient": "Back again?",
  "THE_ARCHITECT.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.1-0r.next": "Continue",
  "THE_ARCHITECT.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.1-1r.char": "Where's your health bar?! Creative mode?",
  "THE_ARCHITECT.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.1-1r.next": "Continue",
  "THE_ARCHITECT.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.1-2r.ancient": "You should be glad I don't fly when I press space twice.",
  "THE_ARCHITECT.talk.STS2_MOMOI_CHARACTER_STS2_MOMOI_CHARACTER.2-0r.char": "Is this where it ends again?",
